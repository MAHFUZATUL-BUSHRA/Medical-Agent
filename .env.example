# --- Choose ONE LLM provider: openai | groq | gemini ---
LLM_PROVIDER=gemini

# Free keys: https://aistudio.google.com/apikey  (Gemini)  |  https://console.groq.com/keys  (Groq)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=gemini-2.5-flash     # optional override

# --- Web search (choose one provider) ---
SEARCH_PROVIDER=tavily          # tavily | serpapi
TAVILY_API_KEY=tvly-...
# SERPAPI_API_KEY=...

# --- Optional ---
# DB_DIR=./databases
# AGENT_VERBOSE=false
